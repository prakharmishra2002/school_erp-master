# ═══════════════════════════════════════════════════════════════════════════════
# 🏫 SCHOOL ERP - Environment Configuration (Docker)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and update the values for your school.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🔧 APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="ABC Public School"
APP_ENV=production
APP_KEY=base64:GENERATE_A_NEW_KEY_HERE
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school_erp
DB_USERNAME=school_erp
DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

# External access port (set to empty to disable external access)
DB_EXTERNAL_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# 📦 REDIS (CACHE & SESSIONS)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─────────────────────────────────────────────────────────────────────────────
# 📧 MAIL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@school.com
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# 📱 SMS GATEWAY (MSG91)
# ─────────────────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=SCHOOL
MSG91_ROUTE=4
MSG91_TEMPLATE_ID=your_template_id

# Or use Twilio
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_FROM=+1234567890

# ─────────────────────────────────────────────────────────────────────────────
# 💳 PAYMENT GATEWAY (RAZORPAY)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─────────────────────────────────────────────────────────────────────────────
# 🖐️ BIOMETRIC DEVICE SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
BIOMETRIC_SYNC_ENABLED=true
BIOMETRIC_SYNC_PORT=4370
BIOMETRIC_SYNC_INTERVAL=5

# ─────────────────────────────────────────────────────────────────────────────
# ☁️ CLOUD SYNC (For parent portal)
# ─────────────────────────────────────────────────────────────────────────────
SYNC_CLOUD_URL=https://cloud.schoolerp.com
SYNC_API_KEY=your_sync_api_key
SYNC_INTERVAL=5

# ─────────────────────────────────────────────────────────────────────────────
# 📁 FILE STORAGE
# ─────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# For cloud storage:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# AWS_BUCKET=school-erp-files

# ─────────────────────────────────────────────────────────────────────────────
# 🔒 SECURITY SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# 📊 LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════════
# 🔌 EXPOSED PORTS SUMMARY
# ═══════════════════════════════════════════════════════════════════════════════
# 
# PORT    SERVICE             DESCRIPTION
# ────    ───────             ───────────
# 8080    Nginx (HTTP)        Main web application
# 8443    Nginx (HTTPS)       Secure web access (when SSL configured)
# 5432    PostgreSQL          Database (optional external access)
# 4370    Biometric Sync      ZKTeco/eSSL device communication
#
# ═══════════════════════════════════════════════════════════════════════════════
